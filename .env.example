# Copy to .env and fill in real values. .env is git-ignored.
# SERPAPI_API_KEY and BLOCKCHAIN_* are required by `python -m faceproof run`.
# FACE_UPLOAD_PROVIDER is optional - it defaults to catbox.

# --- Web / social media discovery (reverse image + web search) ---
SERPAPI_API_KEY=

# Anonymous host that publishes the (resized) probe so Google Lens can fetch it.
# catbox = permanent | litterbox = expires after 1h | 0x0 = currently disabled (HTTP 503).
# Free services, no availability guarantee - switch hosts if an upload fails.
FACE_UPLOAD_PROVIDER=catbox

# --- Blockchain verification ---
BLOCKCHAIN_RPC_URL=https://sepolia.base.org
# Throwaway wallet only. Fund from a Base Sepolia faucet. Never a key with real funds.
BLOCKCHAIN_PRIVATE_KEY=

# --- Internal Engine REST API (optional; see face_engine/api) ---
# DEEPFACE_FACE_RECOGNITION_MODELS=ArcFace
# DEEPFACE_FACE_DETECTION_MODELS=retinaface
# DEEPFACE_AUTH_TOKEN=
