# Copy to .env and fill in real values. .env is git-ignored.
# All three below are required by `python -m faceproof run`.

# --- Web / social media discovery (reverse image + web search) ---
SERPAPI_API_KEY=

# --- Blockchain verification ---
BLOCKCHAIN_RPC_URL=https://sepolia.base.org
# Throwaway wallet only. Fund from a Base Sepolia faucet. Never a key with real funds.
BLOCKCHAIN_PRIVATE_KEY=

# --- Internal Engine REST API (optional; see face_engine/api) ---
# DEEPFACE_FACE_RECOGNITION_MODELS=ArcFace
# DEEPFACE_FACE_DETECTION_MODELS=retinaface
# DEEPFACE_AUTH_TOKEN=
