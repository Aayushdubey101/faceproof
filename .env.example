# Copy to .env and fill in real values. .env is git-ignored.
# SERPAPI_API_KEY and BLOCKCHAIN_* are required by `python -m faceproof run`.
# FACE_UPLOAD_PROVIDER is optional - it defaults to catbox.

# --- Web / social media discovery (reverse image + web search) ---
SERPAPI_API_KEY=

# Anonymous host that publishes the (resized) probe so Google Lens can fetch it.
# catbox = permanent | litterbox = expires after 1h | 0x0 = currently disabled (HTTP 503).
# Free services, no availability guarantee - switch hosts if an upload fails.
FACE_UPLOAD_PROVIDER=catbox

# --- Blockchain verification ---
BLOCKCHAIN_RPC_URL=https://sepolia.base.org
# Throwaway wallet only. Fund from a Base Sepolia faucet. Never a key with real funds.
BLOCKCHAIN_PRIVATE_KEY=

# --- Performance (optional) ---
# How many candidate images may download at once. Default 4, clamped to 1-8.
# Downloads are latency-bound, so a few in flight hides them behind face
# comparison; more sockets buy nothing on a few-KB thumbnail.
# FACEPROOF_DOWNLOAD_WORKERS=4

# How many candidate face comparisons may run at once. Default 2, clamped to
# 1-4. RetinaFace already uses every core for one image, so a second comparison
# only fills the gaps it leaves: measured 26.8s -> 23.3s over 25 candidates, for
# about 0.6 GiB more memory. Set to 1 on a memory-tight machine; the verdicts
# are identical either way, it only costs time.
# FACEPROOF_COMPARE_WORKERS=2

# --- Internal Engine REST API (optional; see face_engine/api) ---
# DEEPFACE_FACE_RECOGNITION_MODELS=ArcFace
# DEEPFACE_FACE_DETECTION_MODELS=retinaface
# DEEPFACE_AUTH_TOKEN=
